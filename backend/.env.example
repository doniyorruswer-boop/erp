# ================================================================
# 🔒 EduCRM SaaS Production Environment Variables Template
# ================================================================

# Application
NODE_ENV=production
PORT=3000
APP_NAME=EduCRM

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://educrm_user:super_secure_password@localhost:5432/educrm?schema=public"

# Authentication & Security
JWT_SECRET="generate-a-strong-64-character-random-secret-key-here"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="generate-another-strong-secret-key-for-refresh"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGIN="https://app.educrm.uz,https://admin.educrm.uz"

# Background Job Queue (Redis)
REDIS_URL="redis://localhost:6379"

# Notification Gateways
# Telegram Bot
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# SMS Gateway (e.g. Eskiz.uz / PlayMobile)
SMS_API_URL="https://notify.eskiz.uz/api"
SMS_EMAIL="your_email@domain.com"
SMS_PASSWORD="your_sms_gateway_password"

# SMTP Email
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="EduCRM <no-reply@educrm.uz>"

# Storage & Uploads
STORAGE_DRIVER="local" # "local" or "s3"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-central-1"
AWS_BUCKET_NAME="educrm-uploads"
